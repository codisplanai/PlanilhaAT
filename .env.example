# ==============================================================================
# PlanAut - Docker / CloudPanel / Dockge / Portainer
# Copie para .env no host. Nunca versione o .env real.
#
# Vercel automatizado publica frontend + FastAPI no mesmo projeto/domínio:
#   produção:        https://planaut.codisplan.com.br
#   desenvolvimento: https://planaut.dev.codisplan.com.br
#
# Os hosts api.planaut.* abaixo permanecem apenas como opção para deployment
# manual Docker/CloudPanel, caso se deseje separar o backend da Vercel.
# ===============================================================================

# Stack / imagem ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=planaut-production
# Production usa o canal humano :production. Releases exatas usam :X.Y.Z.
PLANAUT_IMAGE=ghcr.io/codisplanai/planilhaat:production
APP_CONTAINER_NAME=planaut-app

# ÚNICA porta publicada pelo compose. Banco e ferramentas não publicam portas.
# CloudPanel -> Reverse Proxy -> http://127.0.0.1:8000
PLANAUT_BIND_ADDRESS=127.0.0.1
PLANAUT_PORT=8000

# URLs operacionais ------------------------------------------------------------
PLANAUT_PUBLIC_URL=https://planaut.codisplan.com.br
PLANAUT_API_PUBLIC_URL=https://api.planaut.codisplan.com.br
PLANAUT_DEVELOPMENT_URL=https://planaut.dev.codisplan.com.br
PLANAUT_DEVELOPMENT_API_URL=https://api.planaut.dev.codisplan.com.br
CLOUDPANEL_UPSTREAM=http://127.0.0.1:8000

# Aplicação --------------------------------------------------------------------
APP_NAME=PlanAut-Backend
APP_ENV=production
DEBUG=false
ENABLE_LOCAL_AUTH=false
AUTO_CREATE_SCHEMA=false
SEED_DEFAULTS=false
RUN_MIGRATIONS_ON_START=true
WAIT_FOR_DATABASE=true
DATABASE_WAIT_ATTEMPTS=30
DATABASE_WAIT_INTERVAL_SECONDS=2

# Banco ------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# PostgreSQL local opcional -----------------------------------------------------
# DATABASE_URL=postgresql://planaut:CHANGE_ME@postgres:5432/planaut
# docker compose --profile local-db up -d
POSTGRES_IMAGE=ghcr.io/codisplanai/planilhaat-postgres:16-alpine
POSTGRES_CONTAINER_NAME=planaut-postgres
POSTGRES_DB=planaut
POSTGRES_USER=planaut
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Supabase ---------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
SUPABASE_STORAGE_BUCKET_TEMPLATES=templates
SUPABASE_STORAGE_BUCKET_OUTPUTS=outputs

# HTTP / CORS ------------------------------------------------------------------
CORS_ORIGINS=https://planaut.codisplan.com.br,https://planaut.dev.codisplan.com.br

# Proteção de upload ------------------------------------------------------------
MAX_UPLOAD_FILE_BYTES=20971520
MAX_UPLOAD_TOTAL_BYTES=104857600
MAX_ZIP_ENTRIES=1000
MAX_ZIP_UNCOMPRESSED_BYTES=104857600
MAX_ZIP_COMPRESSION_RATIO=100

# Logs / limpeza ---------------------------------------------------------------
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
PRUNE_AFTER_HOURS=2

# Deployment manual ------------------------------------------------------------
# CloudPanel / Docker / Dockge / Portainer são alternativas manuais.
# Nenhuma credencial SSH ou DEPLOY_* é usada pelos GitHub Actions.
# Use este arquivo somente ao preparar manualmente uma stack nesses ambientes.

# ------------------------------------------------------------------------------
# DESENVOLVIMENTO DOCKER
# ------------------------------------------------------------------------------
# Para development use os mesmos arquivos com estas alterações no .env real:
# COMPOSE_PROJECT_NAME=planaut-development
# PLANAUT_IMAGE=ghcr.io/codisplanai/planilhaat:develop
# APP_CONTAINER_NAME=planaut-dev-app
# APP_ENV=development
# PLANAUT_PORT=8001
# PLANAUT_PUBLIC_URL=https://planaut.dev.codisplan.com.br
# PLANAUT_API_PUBLIC_URL=https://api.planaut.dev.codisplan.com.br
# CLOUDPANEL_UPSTREAM=http://127.0.0.1:8001
# CORS_ORIGINS=https://planaut.dev.codisplan.com.br

# Tags GHCR esperadas -----------------------------------------------------------
# Aplicação: develop, production, latest, X.Y.Z, X.Y e X
# Node base: 22-alpine, 22, latest
# Python base: 3.12-slim, 3.12, 3, latest
# PostgreSQL: 16-alpine, 16, latest
