# ==============================================================================
# PlanilhaAT / PlanAut - Docker production example
# Copy this file to .env on the host or import it into Portainer/Dockge.
# Never commit the real .env file.
# ===============================================================================

# Stack / application image -----------------------------------------------------
COMPOSE_PROJECT_NAME=planilhaat
PLANAUT_IMAGE=ghcr.io/codisplanai/planilhaat:latest
APP_CONTAINER_NAME=planilhaat-app
BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# Application ------------------------------------------------------------------
APP_NAME=PlanAut-Backend
APP_ENV=production
DEBUG=false
ENABLE_LOCAL_AUTH=false
AUTO_CREATE_SCHEMA=false
SEED_DEFAULTS=false
RUN_MIGRATIONS_ON_START=true
WAIT_FOR_DATABASE=true
DATABASE_WAIT_ATTEMPTS=30
DATABASE_WAIT_INTERVAL_SECONDS=2

# Database ---------------------------------------------------------------------
# Recommended production mode: Supabase/PostgreSQL pooler or your managed DB.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Optional LOCAL PostgreSQL profile --------------------------------------------
# To use it:
#   1) set DATABASE_URL=postgresql://planilhaat:CHANGE_ME@postgres:5432/planilhaat
#   2) set a strong POSTGRES_PASSWORD
#   3) start with: docker compose --profile local-db up -d
POSTGRES_IMAGE=ghcr.io/codisplanai/planilhaat-postgres:16-alpine
POSTGRES_CONTAINER_NAME=planilhaat-postgres
POSTGRES_DB=planilhaat
POSTGRES_USER=planilhaat
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Supabase ---------------------------------------------------------------------
# SUPABASE_KEY is the anon/public key and is intentionally exposed to the
# browser through runtime-config.js. SERVICE_ROLE and JWT_SECRET stay server-side.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
SUPABASE_STORAGE_BUCKET_TEMPLATES=templates
SUPABASE_STORAGE_BUCKET_OUTPUTS=outputs

# HTTP / browser ---------------------------------------------------------------
CORS_ORIGINS=https://planilhaat.example.com

# Upload protection ------------------------------------------------------------
MAX_UPLOAD_FILE_BYTES=20971520
MAX_UPLOAD_TOTAL_BYTES=104857600
MAX_ZIP_ENTRIES=1000
MAX_ZIP_UNCOMPRESSED_BYTES=104857600
MAX_ZIP_COMPRESSION_RATIO=100

# Docker logs / local cleanup ---------------------------------------------------
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
PRUNE_AFTER_HOURS=2

# CI/CD SSH deployment (host-side values, not read by the app) -----------------
# DEPLOY_PATH=/opt/planilhaat
