# ==============================================================================
# PlanAut - ambiente de PRODUCAO para Docker Compose
# Copie para .env na VPS e preencha os valores reais.
# NUNCA versione o arquivo .env.
# ==============================================================================

# Imagem publicada pelo GitHub Actions no GHCR.
# O pacote GHCR deve ser configurado como Public no GitHub após a 1a publicação.
PLANAUT_IMAGE=ghcr.io/SEU_USUARIO_OU_ORG/SEU_REPOSITORIO:latest
APP_PORT=8000

# Aplicacao
APP_NAME=PlanAut-Backend
APP_ENV=production
DEBUG=False
ENABLE_LOCAL_AUTH=False
AUTO_CREATE_SCHEMA=False
SEED_DEFAULTS=False

# PostgreSQL / Supabase
# Prefira o Pooler do Supabase quando aplicavel ao seu ambiente.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Supabase Auth/API
# SUPABASE_KEY e a chave anon/publica e tambem e entregue ao frontend em runtime.
# A SERVICE_ROLE nunca e exposta ao frontend.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=SUA_CHAVE_ANON_PUBLICA
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=SEU_JWT_SECRET

# Supabase Storage
SUPABASE_STORAGE_BUCKET_TEMPLATES=templates
SUPABASE_STORAGE_BUCKET_OUTPUTS=outputs

# Storage local persistente dentro dos volumes Docker.
STORAGE_DIR=/app/storage
TEMPLATES_DIR=/app/storage/templates
OUTPUTS_DIR=/app/storage/outputs
UPLOADS_DIR=/app/storage/uploads
BUNDLED_TEMPLATES_DIR=/app/bundled_templates

# Origens adicionais permitidas para chamadas cross-origin.
# Se frontend e API usam o mesmo dominio, mantenha somente o dominio de producao.
CORS_ORIGINS=https://planaut.seudominio.com.br

# Limites de upload / protecao ZIP
MAX_UPLOAD_FILE_BYTES=20971520
MAX_UPLOAD_TOTAL_BYTES=104857600
MAX_ZIP_ENTRIES=1000
MAX_ZIP_UNCOMPRESSED_BYTES=104857600
MAX_ZIP_COMPRESSION_RATIO=100

# Manutenção local Docker na VPS.
# Após deploy bem-sucedido, remove imagens dangling não usadas há mais deste período.
PRUNE_AFTER_HOURS=2
