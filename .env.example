# Configurações da Aplicação
APP_NAME=PlanilhaAT-Backend
APP_ENV=development
DEBUG=True
ENABLE_LOCAL_AUTH=False
AUTO_CREATE_SCHEMA=False
SEED_DEFAULTS=False

# Banco de Dados Supabase (PostgreSQL)
# Exemplo com Pooler Supabase (Session mode port 5432 ou Transaction mode port 6543):
# DATABASE_URL=postgresql://postgres.xxxx:sua_senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Para desenvolvimento/testes locais sem Supabase:
DATABASE_URL=sqlite:///./planilha_at.db

# Supabase API & Auth
SUPABASE_URL=https://sua-url-supabase.supabase.co
SUPABASE_KEY=sua_anon_key
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
SUPABASE_JWT_SECRET=seu_jwt_secret_se_validar_localmente

# Storage Buckets Supabase
SUPABASE_STORAGE_BUCKET_TEMPLATES=templates
SUPABASE_STORAGE_BUCKET_OUTPUTS=outputs

# Diretórios de Armazenamento Local (Cache / Híbrido)
STORAGE_DIR=./storage
TEMPLATES_DIR=./storage/templates
OUTPUTS_DIR=./storage/outputs
UPLOADS_DIR=./storage/uploads

# Origens permitidas, separadas por vírgula (defina o domínio real em produção)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Limites de upload e proteção contra ZIP bomb
MAX_UPLOAD_FILE_BYTES=20971520
MAX_UPLOAD_TOTAL_BYTES=104857600
MAX_ZIP_ENTRIES=1000
MAX_ZIP_UNCOMPRESSED_BYTES=104857600
MAX_ZIP_COMPRESSION_RATIO=100

# Apenas para um ambiente local isolado, nunca em produção:
# ENABLE_LOCAL_AUTH=True
# SEED_DEFAULTS=True
