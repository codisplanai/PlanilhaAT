# ==============================================================================
# PlanAut - Vercel full-stack via GitHub Actions
# Reference only. Never commit real tokens or private backend credentials.
#
# One Vercel project: planaut
# Frontend: https://planaut.codisplan.com.br/
# API:      https://planaut.codisplan.com.br/api/*
# ==============================================================================

# GITHUB ENVIRONMENT SECRET (development and production) ------------------------
VERCEL_TOKEN=SET_IN_GITHUB_ENVIRONMENT

# Frontend public values --------------------------------------------------------
# VITE_API_URL is intentionally NOT configured on Vercel.
# The frontend uses same-origin /api/v1.
#
# development:
# VITE_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_DEV_PUBLISHABLE_KEY
#
# production:
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Backend private/runtime values ------------------------------------------------
# Configure in each GitHub Environment as Secrets.
DATABASE_URL=SET_IN_GITHUB_ENVIRONMENT

# Optional/legacy administrative secret. It is NOT part of fiscal file
# processing and must never be exposed to the browser.
# SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IF_AN_ADMIN_FEATURE_REQUIRES_IT

# Optional backend names. The workflow falls back to the VITE public values
# for SUPABASE_URL and SUPABASE_KEY when these are not separately configured.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_KEY=YOUR_PUBLISHABLE_KEY
# SUPABASE_JWT_SECRET=OPTIONAL

# Repository / Environment Variables -------------------------------------------
VERCEL_SCOPE=codisplan
VERCEL_PROJECT_NAME=planaut
VERCEL_DEVELOPMENT_DOMAIN=planaut.dev.codisplan.com.br
VERCEL_PRODUCTION_DOMAIN=planaut.codisplan.com.br
VERCEL_CLI_VERSION=59.19.1
CORS_ORIGINS=https://planaut.codisplan.com.br,https://planaut.dev.codisplan.com.br

# Routing inside the single Vercel project -------------------------------------
# /api/*       -> FastAPI service
# /v1/*        -> FastAPI legacy alias
# /docs        -> FastAPI
# /openapi.json-> FastAPI
# everything else -> Vite frontend

# NEVER expose to Vite/frontend -------------------------------------------------
# DATABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_JWT_SECRET
# private keys / SSH credentials

# MANUAL DEPLOYMENT PACKAGES ----------------------------------------------------
# CloudPanel, Docker Compose, Dockge and Portainer remain optional manual
# deployment alternatives and do not participate in GitHub Actions.

# RELEASE RULE -----------------------------------------------------------------
# main -> tests -> GHCR candidate -> Vercel full-stack health -> stable GHCR
# aliases -> Git tag + GitHub Release.

# ZERO-UPLOAD PROCESSING ---------------------------------------------------------
# User fiscal files (XML/ZIP/SPED/XLS/XLSX) must remain in browser memory.
# Do not add VITE upload URLs, server multipart endpoints, Storage uploads,
# temporary server upload directories, or raw-file persistence to the
# automated Vercel architecture.
