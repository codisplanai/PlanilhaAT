# ==============================================================================
# PlanAut - Vercel frontend deployment
# Este arquivo é apenas referência. Não coloque tokens reais no Git.
# Configure as variáveis em Vercel > Project > Settings > Environment Variables.
# ===============================================================================

# PRODUCTION -------------------------------------------------------------------
# Domain: https://planaut.codisplan.com.br
# Scope Vercel: Production
VITE_API_URL=https://api.planaut.codisplan.com.br
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# DEVELOPMENT ------------------------------------------------------------------
# Domain: https://planaut.dev.codisplan.com.br
# Scope Vercel: Preview, branch develop
# Use os mesmos nomes de variáveis acima com valores do ambiente development:
# VITE_API_URL=https://api.planaut.dev.codisplan.com.br
# VITE_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_DEV_ANON_PUBLIC_KEY

# NUNCA expor no frontend/Vite -------------------------------------------------
# DATABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_JWT_SECRET
# POSTGRES_PASSWORD
# qualquer chave privada/secret

# GITHUB ACTIONS - Secrets ------------------------------------------------------
# Configure no GitHub, não na Vercel e não em arquivos .env versionados:
# VERCEL_TOKEN=<Vercel access token>
# VERCEL_ORG_ID=<orgId/teamId do projeto>
# VERCEL_PROJECT_ID=<projectId do frontend>

# GITHUB ACTIONS - Repository Variables ----------------------------------------
# VERCEL_DEPLOY_ENABLED=true
# VERCEL_PRODUCTION_DOMAIN=planaut.codisplan.com.br
# VERCEL_DEVELOPMENT_DOMAIN=planaut.dev.codisplan.com.br

# Backend Docker/CloudPanel -----------------------------------------------------
# O backend permanece fora da Vercel para suportar uploads acima de 4.5 MB.
# CloudPanel deve publicar:
#   api.planaut.codisplan.com.br     -> http://127.0.0.1:8000
#   api.planaut.dev.codisplan.com.br -> http://127.0.0.1:<porta-do-stack-dev>
