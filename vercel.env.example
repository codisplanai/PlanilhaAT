# ==============================================================================
# PlanAut - Vercel frontend via GitHub Actions
# Reference only. Never commit real tokens or private backend credentials.
# Official flow: GitHub -> GitHub Actions -> Vercel.
# ===============================================================================

# CURRENT BOOTSTRAP STATE -------------------------------------------------------
# The Vercel team is Codisplan (scope: codisplan).
# The workflow does NOT require a pre-existing VERCEL_PROJECT_ID anymore.
# On the first configured run it links/creates project "planaut" automatically.

# GITHUB ENVIRONMENT SECRET (development and production) ------------------------
VERCEL_TOKEN=SET_IN_GITHUB_ENVIRONMENT

# Frontend runtime/build values -------------------------------------------------
# Configure these as GitHub Environment Variables, except the anon key can be
# stored as a secret if preferred. These values are public frontend configuration,
# never service-role credentials.
#
# development:
# VITE_API_URL=https://api.planaut.dev.codisplan.com.br
# VITE_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_DEV_ANON_PUBLIC_KEY
#
# production:
# VITE_API_URL=https://api.planaut.codisplan.com.br
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Repository / Environment Variables -------------------------------------------
VERCEL_SCOPE=codisplan
VERCEL_PROJECT_NAME=planaut
VERCEL_API_PROJECT_NAME=planaut-api
VERCEL_DEVELOPMENT_DOMAIN=planaut.dev.codisplan.com.br
VERCEL_PRODUCTION_DOMAIN=planaut.codisplan.com.br
VERCEL_API_DOMAIN=api.planaut.codisplan.com.br
VERCEL_CLI_VERSION=59.19.1

# Backend runtime values (GitHub Environment production) -----------------------
# Required for the separate Vercel project "planaut-api".
# Store private values as Environment Secrets.
# DATABASE_URL=postgresql://...
# SUPABASE_SERVICE_ROLE_KEY=...
# Optional: SUPABASE_JWT_SECRET=...
#
# SUPABASE_URL and SUPABASE_KEY are resolved from dedicated backend names first
# and fall back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY when present.
# The service-role key is never exposed to the Vite frontend.

# NEVER expose to Vite/frontend -------------------------------------------------
# DATABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_JWT_SECRET
# POSTGRES_PASSWORD
# private keys / SSH credentials

# MANUAL DEPLOYMENT PACKAGES ----------------------------------------------------
# CloudPanel, Docker Compose, Dockge and Portainer packages are repository
# artifacts for manual use only. GitHub Actions does not connect to those
# environments and does not require SSH/DEPLOY_* credentials.

# RELEASE RULE -----------------------------------------------------------------
# CI validates and publishes the GitHub/GHCR release artifacts.
# GitHub Release publication triggers the Vercel production workflow.
# Vercel is the only automated deployment destination.
