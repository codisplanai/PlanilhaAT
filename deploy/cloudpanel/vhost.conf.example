# Add these directives to the CloudPanel site's reverse-proxy/vhost configuration.
# CloudPanel remains responsible for domain, Let's Encrypt TLS and public ports.
# The PlanilhaAT container binds only to 127.0.0.1:8000 by default.

location / {
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}

location = /sw.js {
    proxy_pass http://127.0.0.1:8000/sw.js;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
}

location = /runtime-config.js {
    proxy_pass http://127.0.0.1:8000/runtime-config.js;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control "no-store, max-age=0" always;
}
